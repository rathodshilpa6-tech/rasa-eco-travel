# Copy to .env and fill in real values. Never commit the real .env file.
# Every key is optional: without it the bot uses clearly labelled
# curated/indicative data instead of the live API.

CLIMATIQ_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
OPENCAGE_API_KEY=

# Optional overrides if Climatiq rejects a default activity ID / data version
# CLIMATIQ_DATA_VERSION=^21
# CLIMATIQ_FLIGHT_ACTIVITY_ID=
# CLIMATIQ_TRAIN_ACTIVITY_ID=
# CLIMATIQ_COACH_ACTIVITY_ID=
